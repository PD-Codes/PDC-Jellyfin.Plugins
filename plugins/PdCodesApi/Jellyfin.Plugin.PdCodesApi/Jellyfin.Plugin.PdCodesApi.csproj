<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Jellyfin 10.10.x runs on .NET 8. Targeting anything else produces a DLL the
         server loads and then silently skips, with only a TypeLoadException in the log. -->
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0.0</Version>
    <RootNamespace>Jellyfin.Plugin.PdCodesApi</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.PdCodesApi</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>false</ImplicitUsings>
    <!-- Off deliberately. With it on, every undocumented public DTO property is a CS1591
         warning; a wall of harmless warnings is how a real one gets missed. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The config page is served out of the assembly as an embedded resource; see Plugin.GetPages(). -->
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- Verified on nuget.org: Jellyfin.Controller 10.10.6 is the latest 10.10.x.
         Jellyfin.Controller transitively brings in Jellyfin.Common and Jellyfin.Model,
         which is where IHttpClientFactory usage, BasePluginConfiguration and
         RemoteImageInfo come from. These are compile-time only: the server supplies
         them at runtime, so they must NOT be copied into the plugin folder. -->
    <PackageReference Include="Jellyfin.Controller" Version="10.10.6">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
